ARG NODE_VERSION=24-slim
ARG PNPM_VERSION=11.25.0
FROM node:${NODE_VERSION} AS base
ARG PNPM_VERSION
RUN npm install --global pnpm@${PNPM_VERSION}
WORKDIR /app
FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/landing/package.json apps/landing/package.json
COPY apps/institution/package.json apps/institution/package.json
COPY apps/admin/package.json apps/admin/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
FROM base AS builder
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
ARG NEXT_PUBLIC_PRODUCT_APP_URL=http://localhost:3000
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} NEXT_PUBLIC_PRODUCT_APP_URL=${NEXT_PUBLIC_PRODUCT_APP_URL}
RUN pnpm --filter @vilivyopotea/admin build
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3003 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
RUN mkdir -p apps/admin/.next && chown -R node:node apps
COPY --from=builder --chown=node:node /app/apps/admin/public ./apps/admin/public
COPY --from=builder --chown=node:node /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/admin/.next/static ./apps/admin/.next/static
USER node
EXPOSE 3003
CMD ["node", "apps/admin/server.js"]
