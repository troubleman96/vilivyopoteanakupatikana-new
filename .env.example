# Local PostgreSQL database credentials; generate a unique password before Compose startup.
POSTGRES_DB=vilivyopotea
POSTGRES_USER=vilivyopotea
POSTGRES_PASSWORD=
# The runtime API password is embedded in DATABASE_URL; use URL-safe characters.
POSTGRES_APP_USER=vilivyopotea_app
POSTGRES_APP_PASSWORD=

# Local API and web origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_INSTITUTION_APP_URL=http://localhost:3004
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3003
# Start the separate VPK documentation app with `pnpm docs:dev`.
NEXT_PUBLIC_VPK_DOCS_URL=http://localhost:3006
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3004
NEXT_PUBLIC_DEMO_MODE=false
PUBLIC_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000
LANDING_HOST_PORT=3001
INSTITUTION_HOST_PORT=3004
ADMIN_HOST_PORT=3003
INSTITUTION_HOSTNAME=institution.example.org
ADMIN_HOSTNAME=admin.example.org
API_HOST_PORT=8080

# Optional internal API-to-AI bearer token. No default is provided.
AI_SERVICE_TOKEN=
AI_MATCHING_ENABLED=false

# Production HTTPS overlay: replace with a real host and an ACME contact address.
# Never put credential values in this file; *_FILE entries name private files.
PUBLIC_HOSTNAME=
LANDING_HOSTNAME=
ACME_EMAIL=
POSTGRES_PASSWORD_FILE=
POSTGRES_APP_PASSWORD_FILE=
MIGRATION_DATABASE_URL_FILE=
RUNTIME_DATABASE_URL_FILE=
AI_SERVICE_TOKEN_FILE=
AI_SERVICE_TOKEN_REQUIRED=false
APP_NETWORK_SUBNET=172.30.40.0/24
CADDY_APP_IP=172.30.40.10
TRUSTED_PROXY_CIDRS=172.30.40.10/32

# Optional local EmbeddingGemma 2 checkpoint for the Compose override only.
EMBEDDINGGEMMA_MODEL_DIR=
EMBEDDINGGEMMA_DEVICE=cpu
