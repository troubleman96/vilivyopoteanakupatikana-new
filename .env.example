# Local-only PostgreSQL. Generate a random password before starting Compose.
POSTGRES_DB=vilivyopotea
POSTGRES_USER=vilivyopotea
POSTGRES_PASSWORD=

# Supabase Auth: leave blank for the synthetic demo. Use the anon/public key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Demo mode is read-only for API writes by default; set false only for an authorized test.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Keep loopback by default; set to 0.0.0.0 only for a temporary test URL.
PUBLIC_BIND_ADDRESS=127.0.0.1
# Change these if the default host ports are already in use.
WEB_HOST_PORT=3000
API_HOST_PORT=8080

# Optional internal API-to-AI bearer token. No default is provided.
AI_SERVICE_TOKEN=
AI_MATCHING_ENABLED=false
