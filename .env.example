# Local PostgreSQL database credentials; generate a unique password before Compose startup.
POSTGRES_DB=vilivyopotea
POSTGRES_USER=vilivyopotea
POSTGRES_PASSWORD=
# The runtime API password is embedded in DATABASE_URL; use URL-safe characters.
POSTGRES_APP_USER=vilivyopotea_app
POSTGRES_APP_PASSWORD=

# Local API and web origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
PUBLIC_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000
API_HOST_PORT=8080

# Optional internal API-to-AI bearer token. No default is provided.
AI_SERVICE_TOKEN=
AI_MATCHING_ENABLED=false

# Optional local EmbeddingGemma 2 checkpoint for the Compose override only.
EMBEDDINGGEMMA_MODEL_DIR=
EMBEDDINGGEMMA_DEVICE=cpu
