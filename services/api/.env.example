# Local PostgreSQL is required for accounts and private API routes.
# Use the migration-owner URL for cmd/migrate; switch DATABASE_URL to the restricted app role for cmd/api.
DATABASE_URL=postgres://vilivyopotea:local-only-password@127.0.0.1:5432/vilivyopotea?sslmode=disable
APP_DATABASE_USER=vilivyopotea_app
APP_DATABASE_PASSWORD=replace-with-url-safe-local-secret
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=
AI_MATCHING_ENABLED=false
